APP_NAME="منصة خطوة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Aden

# ============================================================
# قاعدة البيانات الجديدة (Laravel)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khutwa_db
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# قاعدة البيانات القديمة (للاستيراد فقط — يُحذف بعدها)
# ============================================================
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_DATABASE=company_db
OLD_DB_USERNAME=root
OLD_DB_PASSWORD=

# ============================================================
# Session & Cache
# ============================================================
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================
# Queue & Horizon
# ============================================================
QUEUE_CONNECTION=redis
DB_QUEUE_TABLE=queue_jobs
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5

HORIZON_NAME=khutwa
HORIZON_PATH=horizon
HORIZON_REDIS_CONNECTION=default
HORIZON_PREFIX=khutwa_horizon:
HORIZON_MEMORY_LIMIT=128
HORIZON_PROD_DEFAULT_PROCESSES=6
HORIZON_PROD_AI_PROCESSES=2
HORIZON_PROD_PDF_PROCESSES=2
HORIZON_PROD_NOTIFICATION_PROCESSES=4
HORIZON_WAIT_DEFAULT=60
HORIZON_WAIT_SEARCH=60
HORIZON_WAIT_NOTIFICATIONS=60
HORIZON_WAIT_MAIL=60
HORIZON_WAIT_AI=180
HORIZON_WAIT_PDF=180
HORIZON_ALERT_EMAIL=
HORIZON_SLACK_WEBHOOK_URL=
HORIZON_SLACK_CHANNEL=

# ============================================================
# Search
# ============================================================
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_PREFIX=khutwa_
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
AI_MATCHING_VERSION=1
AI_MATCHING_EXPLANATIONS=true
AI_JOB_MATCHING_PROVIDER=openai
AI_AUTO_FILTERING_PROVIDER=openai

RESUME_DEFAULT_TEMPLATE=modern
RESUME_DISK=private
RESUME_PDF_QUEUE=pdf
RESUME_PDF_FORMAT=A4
RESUME_PDF_TIMEOUT=120
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=

# ============================================================
# Mail (مرحلة 2 — استخدم log في التطوير)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@khutwa.com"
MAIL_FROM_NAME="منصة خطوة"

# ============================================================
# Storage
# ============================================================
FILESYSTEM_DISK=local
SENSITIVE_FILESYSTEM_DISK=private
SIGNED_FILE_URL_TTL=15

# ============================================================
# Logging
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Stripe Payment Gateway
# ============================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# خطوات الإعداد:
# 1. أنشئ حساب على https://dashboard.stripe.com
# 2. اذهب لـ Developers > API keys
# 3. انسخ Publishable key → STRIPE_KEY
# 4. انسخ Secret key → STRIPE_SECRET
# 5. اذهب لـ Developers > Webhooks > Add endpoint
#    URL: https://your-domain.com/stripe/webhook
#    Events: checkout.session.completed, invoice.payment_succeeded,
#            invoice.payment_failed, customer.subscription.deleted
# 6. انسخ Signing secret → STRIPE_WEBHOOK_SECRET

# ============================================================
# OpenAI API
# ============================================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT=60

# ============================================================
# Gemini API
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
