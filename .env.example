APP_NAME="منصة خطوة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Aden

# ============================================================
# قاعدة البيانات الجديدة (Laravel)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khutwa_db
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# قاعدة البيانات القديمة (للاستيراد فقط — يُحذف بعدها)
# ============================================================
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_DATABASE=company_db
OLD_DB_USERNAME=root
OLD_DB_PASSWORD=

# ============================================================
# Session & Cache
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================
# Queue (للإشعارات — مرحلة 2)
# ============================================================
QUEUE_CONNECTION=redis
DB_QUEUE_TABLE=queue_jobs
REDIS_QUEUE=default

RESUME_DEFAULT_TEMPLATE=modern
RESUME_DISK=private
RESUME_PDF_QUEUE=pdf
RESUME_PDF_FORMAT=A4
RESUME_PDF_TIMEOUT=120
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
REDIS_QUEUE_RETRY_AFTER=120

# ============================================================
# Mail (مرحلة 2 — استخدم log في التطوير)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@khutwa.com"
MAIL_FROM_NAME="منصة خطوة"

# ============================================================
# Storage
# ============================================================
FILESYSTEM_DISK=local
SENSITIVE_FILESYSTEM_DISK=private
SIGNED_FILE_URL_TTL=15

# ============================================================
# Logging
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Stripe Payment Gateway
# ============================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# خطوات الإعداد:
# 1. أنشئ حساب على https://dashboard.stripe.com
# 2. اذهب لـ Developers > API keys
# 3. انسخ Publishable key → STRIPE_KEY
# 4. انسخ Secret key → STRIPE_SECRET
# 5. اذهب لـ Developers > Webhooks > Add endpoint
#    URL: https://your-domain.com/stripe/webhook
#    Events: checkout.session.completed, invoice.payment_succeeded,
#            invoice.payment_failed, customer.subscription.deleted
# 6. انسخ Signing secret → STRIPE_WEBHOOK_SECRET

# ============================================================
# OpenAI API
# ============================================================
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=  # اختياري
